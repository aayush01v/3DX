{
  "name": "carx-physics-simulator",
  "version": "2.3.0",
  "description": "Interactive C++ physics engine with realistic car simulation and 3D visualization",
  "main": "preview/final-demo.html",
  "scripts": {
    "start": "cd preview && python -m http.server 8080",
    "preview": "cd preview && python -m http.server 8080",
    "build": "echo 'Static preview already built; skipping native CMake build.'",
    "build:native": "mkdir -p build && cd build && cmake .. && cmake --build .",
    "build:android": "cd android && chmod +x build_apk.sh && ./build_apk.sh",
    "build:apk": "cd android && ./gradlew assembleDebug",
    "build:apk:release": "cd android && ./gradlew assembleRelease",
    "deploy": "netlify deploy --prod --dir=preview",
    "deploy:vercel": "npx vercel --prebuilt --prod --confirm"
  },
  "keywords": [
    "physics",
    "simulation",
    "car",
    "kinematics",
    "education",
    "webgl",
    "threejs",
    "cpp"
  ],
  "author": "CarX Simulator Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aayush01v-creator/3DX.git"
  },
  "files": [
    "preview/",
    "src/",
    "include/",
    "examples/",
    "docs/",
    "CMakeLists.txt",
    "README.md",
    "DEPLOYMENT.md"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "netlify-cli": "^17.0.0"
  }
}
