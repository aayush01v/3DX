{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "preview" } }
  ],
  "routes": [
    {
      "src": "/(.*)\\.(glb|gltf)",
      "dest": "/$1.$2",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "src": "/(.*)\\.(exr|png|jpg|jpeg|gif|svg|webp|js|css)",
      "dest": "/$1.$2",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    { "src": "/", "dest": "/final-demo.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
