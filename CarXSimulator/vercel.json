{
  "version": 2,
  "builds": [
    {
      "src": "preview/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/preview/final-demo.html" },
    { "source": "/((?!.*\\.).*)", "destination": "/preview/final-demo.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(glb|gltf)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)\\.(exr|png|jpg|jpeg|gif|svg|webp|js|css)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "trailingSlash": false
}
