{
  "$schema": "./scene_schema.json",
  "version": "1.0.0",
  "metadata": {
    "name": "CarX Simulator Scene",
    "author": "CarX Team",
    "created": "2024-11-30",
    "description": "Unified scene definition for cross-platform compatibility"
  },
  
  "coordinate_system": {
    "up": "Y",
    "forward": "-Z",
    "right": "X",
    "units": "meters"
  },
  
  "assets": {
    "car": {
      "model": "preview/lowpoly_game_model.glb",
      "fallback": "procedural",
      "scale": 1.0
    },
    "tree": {
      "model": "preview/tree.glb",
      "fallback": "procedural",
      "scale": 1.0
    }
  },
  
  "car": {
    "name": "Car",
    "transform": {
      "position": [0, 0.85, 0],
      "rotation": [0, 0, 0],
      "scale": [1, 1, 1]
    },
    "physics": {
      "mass": 1200,
      "wheelbase": 2.6,
      "track_width": 1.8,
      "wheel_radius": 0.35,
      "ground_clearance": 0.5,
      "center_of_mass": [0, 0.4, 0]
    },
    "wheels": [
      {"name": "wheel_FL", "position": [-0.9, 0.35, 1.3], "steering": true, "drive": false},
      {"name": "wheel_FR", "position": [0.9, 0.35, 1.3], "steering": true, "drive": false},
      {"name": "wheel_RL", "position": [-0.9, 0.35, -1.3], "steering": false, "drive": true},
      {"name": "wheel_RR", "position": [0.9, 0.35, -1.3], "steering": false, "drive": true}
    ],
    "body_parts": [
      {
        "name": "body",
        "type": "box",
        "dimensions": [2.0, 0.8, 4.0],
        "position": [0, 0.6, 0],
        "material": {"color": "#FF6B35", "metalness": 0.7, "roughness": 0.3}
      },
      {
        "name": "cabin",
        "type": "box",
        "dimensions": [1.6, 0.7, 2.0],
        "position": [0, 1.15, -0.3],
        "material": {"color": "#2C3E50", "metalness": 0.8, "roughness": 0.2}
      },
      {
        "name": "hood",
        "type": "box",
        "dimensions": [1.8, 0.3, 1.5],
        "position": [0, 0.85, 1.25],
        "material": {"color": "#FF6B35", "metalness": 0.7, "roughness": 0.3}
      },
      {
        "name": "spoiler",
        "type": "box",
        "dimensions": [1.8, 0.1, 0.6],
        "position": [0, 1.3, -1.8],
        "rotation": [-0.2, 0, 0],
        "material": {"color": "#FF6B35", "metalness": 0.7, "roughness": 0.3}
      }
    ],
    "lights": {
      "headlights": [
        {"position": [-0.7, 0.7, 2.05], "color": "#FFFFAA", "intensity": 1.0},
        {"position": [0.7, 0.7, 2.05], "color": "#FFFFAA", "intensity": 1.0}
      ],
      "taillights": [
        {"position": [-0.7, 0.7, -2.05], "color": "#FF0000", "intensity": 0.8},
        {"position": [0.7, 0.7, -2.05], "color": "#FF0000", "intensity": 0.8}
      ]
    }
  },
  
  "terrain": {
    "type": "procedural",
    "size": 400,
    "segments": 120,
    "height_scale": 8,
    "noise": {
      "type": "perlin",
      "octaves": 3,
      "frequency": [0.02, 0.015, 0.01],
      "amplitude": [2, 1.5, 3]
    },
    "material": {
      "color": "#4A7D32",
      "roughness": 0.85
    }
  },
  
  "environment": {
    "sky": {
      "type": "gradient",
      "top_color": "#87CEEB",
      "bottom_color": "#E0F7FA"
    },
    "sun": {
      "position": [50, 100, 50],
      "rotation": [45, 30, 0],
      "color": "#FFF5E6",
      "intensity": 1.5,
      "shadows": true
    },
    "ambient": {
      "color": "#FFFFFF",
      "intensity": 0.4
    },
    "fog": {
      "enabled": true,
      "color": "#CCCCCC",
      "near": 100,
      "far": 500
    }
  },
  
  "camera": {
    "default": {
      "position": [15, 10, 15],
      "target": [0, 2, 0],
      "fov": 60,
      "near": 0.1,
      "far": 2000
    },
    "follow": {
      "distance": 25,
      "height": 10,
      "angle": 0,
      "pitch": 0.4,
      "smooth": 0.1
    }
  },
  
  "vegetation": {
    "enabled": true,
    "trees": {
      "count": 50,
      "spawn_area": {"min": [-80, -80], "max": [80, 80]},
      "exclusion_zone": {"center": [0, 0], "radius_x": 10, "radius_z": 30},
      "scale_range": [0.8, 1.2]
    }
  }
}
