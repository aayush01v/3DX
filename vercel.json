{
  "version": 2,
  "builds": [
    {
      "src": "CarXSimulator/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "preview" }
    }
  ],
  "installCommand": "cd CarXSimulator && echo 'Skipping package install for static preview deployment.'",
  "buildCommand": "echo 'Using prebuilt preview/ assets for deployment.'",
  "outputDirectory": "CarXSimulator/preview",
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/final-demo.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(glb|gltf)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)\\.(exr|png|jpg|jpeg|gif|svg|webp|js|css)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "trailingSlash": false
}
