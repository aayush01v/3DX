{
  "version": 2,
  "builds": [
    {
      "src": "CarXSimulator/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "preview" }
    }
  ],
  "installCommand": "echo 'Skipping package install for static preview deployment.'",
  "buildCommand": "mkdir -p preview && cp -a CarXSimulator/preview/. preview/",
  "outputDirectory": "preview",
  "rewrites": [
    { "source": "/", "destination": "/final-preview.html" },
    { "source": "/:path*", "destination": "/final-preview.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(glb|gltf)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)\\.(exr|png|jpg|jpeg|gif|svg|webp|js|css)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "trailingSlash": false
}
